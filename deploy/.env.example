# Into the Void - Docker Swarm Deployment Environment Variables
# Copy to .env and fill in production values before deploying

# ================================
# Required - No defaults, must set
# ================================

# Database password (no default for security)
POSTGRES_PASSWORD=change_me_to_secure_password

# JWT secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=change_me_to_secure_secret

# ================================
# Optional - Have sensible defaults
# ================================

# Database configuration
POSTGRES_USER=postgres
POSTGRES_DB=into_the_void

# Domain for routing (used by Traefik in Phase 91)
DOMAIN=intothevoid.online

# Container registry (GHCR by default)
REGISTRY=ghcr.io/OWNER/REPO

# Image tag (defaults to latest)
TAG=latest

# ================================
# Deployment Notes
# ================================
#
# 1. Generate secure passwords:
#    openssl rand -base64 32
#
# 2. Update REGISTRY to match your GitHub Container Registry:
#    REGISTRY=ghcr.io/your-username/into-the-void
#
# 3. Deploy with:
#    docker stack deploy -c docker-stack.yml --with-registry-auth itv
#
# 4. Check status:
#    docker stack services itv
#    docker service logs itv_api
