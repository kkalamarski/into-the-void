{
  "name": "game-logic",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/game-logic/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/game-logic",
        "main": "packages/game-logic/src/index.ts",
        "tsConfig": "packages/game-logic/tsconfig.lib.json",
        "assets": [],
        "generatePackageJson": true,
        "format": ["cjs", "esm"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "passWithNoTests": true,
        "configFile": "packages/game-logic/vitest.config.ts",
        "reportsDirectory": "../../coverage/packages/game-logic"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["packages/game-logic/**/*.ts"]
      }
    }
  }
}
